@inject IConfiguration Configuration
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var publicDemo = Configuration.GetValue<bool>("Demo:PublicHosting");
    var archived = string.Equals(Context.Request.Query["Archived"], "true", StringComparison.OrdinalIgnoreCase)
        || Model is WorkOrderDto { IsArchived: true };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f7" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] · ForgeOps</title>
    <link rel="icon" type="image/png" href="~/images/forgeops-logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<svg class="icon-definitions" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
<symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
<symbol id="i-orders" viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2M9 9h6M9 13h6M9 17h4"/></symbol>
<symbol id="i-archive" viewBox="0 0 24 24"><path d="M4 8v12h16V8M9 12h6"/><rect x="3" y="3" width="18" height="5" rx="1"/></symbol>
<symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
<symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
<symbol id="i-refresh" viewBox="0 0 24 24"><path d="M20 8a9 9 0 1 0 0 8M20 3v5h-5"/></symbol>
<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
<symbol id="i-tool" viewBox="0 0 24 24"><path d="M14 6a5 5 0 0 0-6 6l-5 5a2.8 2.8 0 0 0 4 4l5-5a5 5 0 0 0 6-6l-3 3-4-4 3-3Z"/></symbol>
<symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
<symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
</svg>
<header class="masthead">
    <div class="masthead-inner">
        <a class="brand" asp-controller="Dashboard" asp-action="Index" aria-label="ForgeOps dashboard">
            <span class="brand-symbol"><img src="~/images/forgeops-logo.png" asp-append-version="true" width="1254" height="1254" alt="" /></span>
            <span class="brand-wordmark">FORGE<span>OPS</span><small>MANUFACTURING WORK ORDER TRACKER</small></span>
        </a>
        <button class="mobile-nav-toggle btn" type="button" data-bs-toggle="collapse" data-bs-target="#primary-nav" aria-controls="primary-nav" aria-expanded="false" aria-label="Toggle navigation">
            <svg class="icon"><use href="#i-menu"/></svg>
        </button>
        <nav id="primary-nav" class="primary-nav collapse" aria-label="Primary navigation">
            <a class="nav-item @(controller == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index" aria-current="@(controller == "Dashboard" ? "page" : null)"><svg class="icon"><use href="#i-grid"/></svg> Overview</a>
            <a class="nav-item @(controller == "WorkOrders" && !archived ? "active" : "")" asp-controller="WorkOrders" asp-action="Index" aria-current="@(controller == "WorkOrders" && !archived ? "page" : null)"><svg class="icon"><use href="#i-orders"/></svg> Work orders</a>
            <a class="nav-item @(archived ? "active" : "")" asp-controller="WorkOrders" asp-action="Index" asp-route-Archived="true" aria-current="@(archived ? "page" : null)"><svg class="icon"><use href="#i-archive"/></svg> Archived</a>
        </nav>
        <div class="workspace-user"><span class="avatar">MC</span><span>Coordinator view<small>Demo persona</small></span></div>
    </div>
</header>
<div class="page-shell">
    <div class="context-bar">
        <div><span class="company-name">NORTHSTAR MANUFACTURING</span><span class="context-divider">/</span><span>Maintenance workspace</span></div>
        <span class="demo-label"><span class="status-dot"></span> @(publicDemo ? "PUBLIC DEMO" : "LOCAL DEMO") <span class="context-divider">/</span> V0.1.0</span>
    </div>
    <main id="main" class="page-content">
        @if (publicDemo) { <div class="notice" role="note">Shared portfolio demo. Use fictional data only; changes may reset after inactivity or redeployment.</div> }
        @if (TempData["Success"] is string success) { <div class="notice notice-success" role="status">@success</div> }
        @if (TempData["Notice"] is string notice) { <div class="notice" role="status">@notice</div> }
        @RenderBody()
    </main>
    <footer class="page-footer">
        <span><strong>FORGEOPS</strong> <span class="footer-separator">/</span> Manufacturing work order tracker</span>
        <span>FACILITY CALENDAR <span class="footer-separator">/</span> America/Halifax</span>
    </footer>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
