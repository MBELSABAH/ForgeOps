@model IReadOnlyList<WorkOrderDto>
@if (Model.Count == 0) {
    <div class="empty-state"><span class="empty-icon"><svg class="icon"><use href="#i-orders"/></svg></span><h3>No work orders to show</h3><p>Try adjusting your filters, or create a work order to get started.</p><a class="btn btn-light" asp-controller="WorkOrders" asp-action="Create">Create work order</a></div>
} else {
<div class="table-responsive"><table class="work-table"><caption class="visually-hidden">Work orders, with equipment, priority, status, assignee and due date</caption><thead><tr><th scope="col">Work order</th><th scope="col">Equipment / facility</th><th scope="col">Priority</th><th scope="col">Status</th><th scope="col">Assigned to</th><th scope="col">Due date</th></tr></thead><tbody>
@foreach (var order in Model) {
    <tr data-priority="@order.Priority"><td><a class="order-link" asp-controller="WorkOrders" asp-action="Details" asp-route-id="@order.Id"><span class="reference">@order.ReferenceNumber</span><span class="order-title">@order.Title</span></a></td><td><span class="table-primary-text">@order.EquipmentName</span><span class="table-secondary-text">@order.Facility</span></td><td><span class="badge-priority priority-@order.Priority.ToString().ToLowerInvariant()"><span class="priority-dot"></span>@order.Priority</span></td><td><span class="badge-status status-@order.Status.ToString().ToLowerInvariant()">@WorkOrderService.Label(order.Status)</span></td><td><span class="assignee-text">@(order.AssignedTechnicianName ?? "Unassigned")</span></td><td><span class="@(order.IsOverdue ? "due-overdue" : "table-primary-text")">@order.DueDate.ToString("MMM d, yyyy")</span>@if(order.IsOverdue){<span class="table-secondary-text due-overdue">Overdue</span>}</td></tr>
}
</tbody></table></div>
}
