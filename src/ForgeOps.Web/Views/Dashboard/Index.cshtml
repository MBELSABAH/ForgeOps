@model DashboardSummaryDto
@{ ViewData["Title"] = "Overview"; }
<div class="page-heading dashboard-heading">
    <div>
        <p class="eyebrow"><span class="eyebrow-line"></span> FACILITY MAINTENANCE / OVERVIEW</p>
        <h1>Maintenance<br />control<span class="heading-period">.</span></h1>
        <p class="page-description">Your floor. Your work orders. Nothing lost in the handover.</p>
    </div>
    <div class="dashboard-actions">
        <span id="operational-date">@Model.Today.ToString("dddd, MMMM d, yyyy")</span>
        <div class="heading-actions">
            <button id="refresh-metrics" class="btn btn-light" type="button"><svg class="icon"><use href="#i-refresh"/></svg> Refresh metrics</button>
            <a class="btn btn-primary" asp-controller="WorkOrders" asp-action="Create"><svg class="icon"><use href="#i-plus"/></svg> New work order</a>
        </div>
        <span id="refresh-feedback" role="status" aria-live="polite">Operational snapshot · archived orders excluded</span>
    </div>
</div>
<div class="metrics-grid" aria-label="Operational metrics">
    <a class="metric-card" asp-controller="WorkOrders" asp-action="Index">
        <div class="metric-top"><span>01 / Total work orders</span><svg class="icon"><use href="#i-orders"/></svg></div>
        <strong data-metric="total">@Model.Total</strong><span class="metric-caption">Across the operational queue</span>
    </a>
    <a class="metric-card" asp-controller="WorkOrders" asp-action="Index" asp-route-Status="Open">
        <div class="metric-top"><span>02 / Open</span><svg class="icon"><use href="#i-plus"/></svg></div>
        <strong data-metric="open">@Model.Open</strong><span class="metric-caption">Awaiting attention</span>
    </a>
    <a class="metric-card" asp-controller="WorkOrders" asp-action="Index" asp-route-Status="InProgress">
        <div class="metric-top"><span>03 / In progress</span><svg class="icon"><use href="#i-tool"/></svg></div>
        <strong data-metric="inProgress">@Model.InProgress</strong><span class="metric-caption">Maintenance underway</span>
    </a>
    <a class="metric-card metric-overdue" asp-controller="WorkOrders" asp-action="Index" asp-route-Overdue="true">
        <div class="metric-top"><span>04 / Overdue</span><svg class="icon"><use href="#i-clock"/></svg></div>
        <strong data-metric="overdue">@Model.Overdue</strong><span class="metric-caption">Past due and unresolved</span>
    </a>
</div>
<div class="command-layout">
    <div class="operations-main">
        <div id="overdue-notice" class="attention-strip" hidden="@(Model.Overdue == 0)">
            <div><span class="attention-symbol">!</span><span><strong><span data-metric="overdue">@Model.Overdue</span> orders are past due</strong><small>Review unresolved work and set the next priority.</small></span></div>
            <a asp-controller="WorkOrders" asp-action="Index" asp-route-Overdue="true">Review overdue <svg class="icon"><use href="#i-arrow"/></svg></a>
        </div>
        <section class="panel table-panel queue-panel">
            <div class="panel-heading">
                <div><p class="panel-kicker">THE WORK QUEUE</p><h2>Recent maintenance activity</h2></div>
                <a class="text-link" asp-controller="WorkOrders" asp-action="Index">View all orders <svg class="icon"><use href="#i-arrow"/></svg></a>
            </div>
            <partial name="_WorkOrderTable" model="Model.RecentlyUpdated" />
            <div class="queue-footer"><span><svg class="icon"><use href="#i-orders"/></svg> Latest five updated work orders</span><span>Most recent first</span></div>
        </section>
    </div>
    <aside class="operations-sidebar" aria-label="Queue breakdown">
        <section class="panel status-overview">
            <div class="panel-heading"><div><p class="panel-kicker">QUEUE DISTRIBUTION</p><h2>Workload by status</h2></div><svg class="icon"><use href="#i-grid"/></svg></div>
            <div class="status-breakdown">
            @foreach (var status in Enum.GetValues<WorkOrderStatus>())
            {
                var count = Model.ByStatus[status.ToString()];
                <div class="status-row">
                    <div><span class="status-label"><span class="legend-dot status-@status.ToString().ToLowerInvariant()"></span>@WorkOrderService.Label(status)</span><strong data-status-count="@status">@count</strong></div>
                    <div class="bar-track"><div class="bar-fill bar-@status.ToString().ToLowerInvariant()" data-status-bar="@status" style="width:@(Model.Total == 0 ? 0 : count * 100 / Model.Total)%"></div></div>
                </div>
            }
            </div>
        </section>
        <section class="panel priority-overview">
            <div class="panel-heading"><div><p class="panel-kicker">FOCUS &amp; URGENCY</p><h2>Priority breakdown</h2></div></div>
            <div class="priority-grid">
            @foreach (var priority in new[] { WorkOrderPriority.Critical, WorkOrderPriority.High, WorkOrderPriority.Medium, WorkOrderPriority.Low })
            {
                <a class="priority-tile" asp-controller="WorkOrders" asp-action="Index" asp-route-Priority="@priority">
                    <span class="badge-priority priority-@priority.ToString().ToLowerInvariant()"><span class="priority-dot"></span>@priority</span>
                    <span class="priority-tile-end"><strong data-priority-count="@priority">@Model.ByPriority[priority.ToString()]</strong><svg class="icon"><use href="#i-arrow"/></svg></span>
                </a>
            }
            </div>
        </section>
    </aside>
</div>
