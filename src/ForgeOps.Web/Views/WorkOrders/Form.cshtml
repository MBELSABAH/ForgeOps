@model WorkOrderFormViewModel
@{ var editing = Model.Id.HasValue; ViewData["Title"] = editing ? "Edit work order" : "New work order"; }
<a class="back-link" asp-action="@(editing ? "Details" : "Index")" asp-route-id="@Model.Id">← @(editing ? "Back to work order" : "Back to work orders")</a>
<div class="page-heading"><div><p class="eyebrow">@(editing ? $"WO-{Model.Id:D6}" : "REPORT AN EQUIPMENT ISSUE")</p><h1>@ViewData["Title"]</h1><p class="page-description">@(editing ? "Keep the information clear and your team aligned." : "Give your maintenance team the details they need to take action.")</p></div></div>
<div class="form-layout">
<section class="panel form-panel"><div class="panel-heading"><div><h2>Work order information</h2><p>Fields marked with an asterisk are required.</p></div></div>
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="order-form">
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    <div class="form-grid">
    <div class="field full"><label asp-for="Input.Title" class="form-label">Title <span class="required-mark">*</span></label><input asp-for="Input.Title" class="form-control" required placeholder="e.g. Investigate vibration on press drive" /><span asp-validation-for="Input.Title" class="field-validation-error"></span><p class="field-hint">A short, specific summary of the problem.</p></div>
    <div class="field"><label asp-for="Input.EquipmentName" class="form-label">Equipment <span class="required-mark">*</span></label><input asp-for="Input.EquipmentName" class="form-control" required placeholder="e.g. Hydraulic press HP-04" /><span asp-validation-for="Input.EquipmentName" class="field-validation-error"></span></div>
    <div class="field"><label asp-for="Input.Facility" class="form-label">Facility <span class="required-mark">*</span></label><input asp-for="Input.Facility" class="form-control" list="facilities" required placeholder="e.g. North plant · Forming" /><datalist id="facilities"><option value="North plant · Forming"/><option value="North plant · Assembly"/><option value="North plant · Packaging"/><option value="North plant · Material handling"/><option value="South plant · Machining"/><option value="South plant · Heat treatment"/><option value="South plant · Quality"/><option value="South plant · Finishing"/></datalist><span asp-validation-for="Input.Facility" class="field-validation-error"></span></div>
    <div class="field full"><label asp-for="Input.Description" class="form-label">Description <span class="required-mark">*</span></label><textarea asp-for="Input.Description" class="form-control" rows="5" required placeholder="Describe the symptoms, location, and any checks already completed."></textarea><span asp-validation-for="Input.Description" class="field-validation-error"></span></div>
    <div class="field"><label asp-for="Input.Priority" class="form-label">Priority <span class="required-mark">*</span></label><select asp-for="Input.Priority" asp-items="Html.GetEnumSelectList<WorkOrderPriority>()" class="form-select" required></select><span asp-validation-for="Input.Priority" class="field-validation-error"></span></div>
    <div class="field"><label asp-for="Input.DueDate" class="form-label">Due date <span class="required-mark">*</span></label><input asp-for="Input.DueDate" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" required /><span asp-validation-for="Input.DueDate" class="field-validation-error"></span></div>
    <div class="field full"><label asp-for="Input.AssignedTechnicianId" class="form-label"></label><select asp-for="Input.AssignedTechnicianId" class="form-select"><option value="">Unassigned</option>@foreach(var technician in Model.Technicians){<option value="@technician.Id">@technician.Name · @technician.Specialty</option>}</select><span asp-validation-for="Input.AssignedTechnicianId" class="field-validation-error"></span></div>
    @if(editing){<div class="field full"><label asp-for="Input.ResolutionNotes" class="form-label"></label><textarea asp-for="Input.ResolutionNotes" class="form-control" rows="4" required="@(Model.Status == WorkOrderStatus.Resolved)"></textarea><span asp-validation-for="Input.ResolutionNotes" class="field-validation-error"></span><p class="field-hint">Required while the order is resolved. Use the status panel on the details page to change status.</p></div>}
    </div>
    <div class="form-actions"><a class="btn btn-light" asp-action="@(editing ? "Details" : "Index")" asp-route-id="@Model.Id">Cancel</a><button type="submit" class="btn btn-primary">@(editing ? "Save changes" : "Create work order") <svg class="icon"><use href="#i-arrow"/></svg></button></div>
</form></section>
<aside class="form-aside"><span class="aside-icon"><svg class="icon"><use href="#i-tool"/></svg></span><h2>A useful report gets work moving.</h2><p>Name the equipment, explain what changed, and include enough context for the technician.</p><div class="aside-tip"><strong>Set the right priority</strong><p>Critical for urgent safety or production concerns. High for significant impact. Medium for routine repairs. Low for minor improvements.</p></div><div class="aside-tip"><strong>One issue, one order</strong><p>Keep separate equipment problems in separate work orders so each resolution is easy to track.</p></div><span class="aside-footnote">@(editing ? "Changes are recorded in the work order history." : "New work orders start with an Open status.")</span></aside>
</div>
